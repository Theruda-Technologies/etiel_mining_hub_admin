NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time Super Admin bootstrap
SUPER_ADMIN_SETUP_SECRET=change-me
SUPER_ADMIN_EMAIL=superadmin@etiel.mining
SUPER_ADMIN_PASSWORD=change-me-now

# Used in invite email redirect links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Invite emails via Resend HTTP API (required) — https://resend.com
# SMTP_PASS (or RESEND_API_KEY) is the Resend API key.
SMTP_PASS=re_xxxxxxxx
SMTP_FROM="Etiel Mining Hub <onboarding@resend.dev>"
# Optional alias:
# RESEND_API_KEY=re_xxxxxxxx
# For a custom domain later, verify it in Resend and set SMTP_FROM to that address.
