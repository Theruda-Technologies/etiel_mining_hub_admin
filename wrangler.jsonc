{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etiel-mining-hub-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "etiel-mining-hub-admin"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ccompobtyzjanpcfmhxi.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HSIdyiSfEkK1Aq50Y6K0JQ_i58feaqb",
    "NEXT_PUBLIC_APP_URL": "https://admin.etielmininghub.com",
    "SMTP_FROM": "Etiel Mining Hub <noreply@admin.etielmininghub.com>"
  }
}
